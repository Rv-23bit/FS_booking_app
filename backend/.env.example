# Copy this file to .env and fill in your own values.
# Do not commit the real .env file.

# MongoDB connection string
MONGO_URI=your_mongodb_connection_string

# Secret used to sign login tokens
JWT_SECRET=your_jwt_secret

# Port the backend runs on
PORT=5001

# The frontend address, used to restrict CORS in production.
# Leave it out during local development to allow all origins.
FRONTEND_URL=http://localhost:3000

# Admin account details, used once by backend/seed/createAdmin.js
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
